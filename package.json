{
    "name": "elite-music",
    "version": "1.10.0-beta.2",
    "private": true,
    "description": "An open-source & feature-packed Discord music bot built on discord.js and discord-player - complete with slash commands, Plex Media Server, Subsonic API & Jellyfin streaming support, Docker, localisation and much more! 🚀💪",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "nodemon index.js",
        "prettier": "prettier \"index.js\" \"{commands,events,utils}/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" --check",
        "prettier:write": "prettier \"index.js\" \"{commands,events,utils}/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" --write",
        "docker:latest": "node scripts/docker-build.js --latest --multi-platform --push",
        "docker:build": "node scripts/docker-build.js",
        "docker:publish": "node scripts/docker-build.js --multi-platform --push"
    },
    "type": "commonjs",
    "author": {
        "name": "ThatGuyJacobee",
        "url": "https://github.com/ThatGuyJacobee"
    },
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThatGuyJacobee/Elite-Music.git"
    },
    "bugs": {
        "url": "https://github.com/ThatGuyJacobee/Elite-Music/issues"
    },
    "homepage": "https://github.com/ThatGuyJacobee/Elite-Music#readme",
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "discord-bot",
        "discord-music-bot",
        "discord.js",
        "discord-player",
        "music-bot",
        "plex-media-server",
        "subsonic-api",
        "jellyfin"
    ],
    "dependencies": {
        "@discordjs/opus": "^0.11.0",
        "@discordjs/rest": "2.6.3",
        "@snazzah/davey": "^0.2.0",
        "bgutils-js": "^4.0.3",
        "discord-api-types": "^0.38.58",
        "discord-player": "^7.2.0",
        "discord-player-youtubei": "^3.1.0",
        "discord.js": "^14.28.1",
        "dotenv": "^18.0.9",
        "ffmpeg-static": "5.3.0",
        "ms": "2.1.3",
        "semver": "^7.8.6",
        "simple-ytdl-core": "^1.2.2",
        "sodium-native": "^5.2.0",
        "youtube-dl-exec": "^3.1.19"
    },
    "devDependencies": {
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10"
    },
    "allowScripts": {
        "@discordjs/opus@0.11.0": true,
        "esbuild@0.27.4": true,
        "ffmpeg-static@5.3.0": true,
        "youtube-dl-exec@3.1.19": true
    },
    "overrides": {}
}
