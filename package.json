{
    "name": "elite-music",
    "version": "1.0.0",
    "description": "Elite Bot's original music feature moved to a separate discord bot.",
    "private": true,
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "nodemon index.js",
        "prettier": "prettier \"index.js\" \"{commands,events,utils}/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" --check",
        "prettier:write": "prettier \"index.js\" \"{commands,events,utils}/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" --write",
        "docker:latest": "node scripts/docker-build.js --latest",
        "docker:build": "node scripts/docker-build.js"
    },
    "type": "commonjs",
    "author": {
        "name": "ThatGuyJacobee",
        "url": "https://github.com/ThatGuyJacobee"
    },
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThatGuyJacobee/Elite-Music.git"
    },
    "bugs": {
        "url": "https://github.com/ThatGuyJacobee/Elite-Music/issues"
    },
    "homepage": "https://github.com/ThatGuyJacobee/Elite-Music#readme",
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "discord-bot",
        "discord-music-bot",
        "discord.js",
        "discord-player",
        "music-bot",
        "plex-media-server",
        "subsonic-api",
        "jellyfin"
    ],
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/rest": "2.6.3",
        "@snazzah/davey": "^0.1.12",
        "bgutils-js": "^4.0.3",
        "discord-api-types": "^0.38.53",
        "discord-player": "^7.2.0",
        "discord-player-youtubei": "^2.0.0",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "ffmpeg-static": "5.3.0",
        "ms": "2.1.3",
        "sodium-native": "^5.1.0",
        "youtube-dl-exec": "^3.1.12"
    },
    "devDependencies": {
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6"
    }
